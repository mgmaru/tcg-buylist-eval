{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mgmaru/tcg-buylist-eval/tasks/buylist-card-id/schemas/output.schema.json",
  "title": "買取表のカード同定：被験エージェントの出力",
  "description": "掲載カードの一覧。決まりは spec.yaml（R-01〜R-12）。値の一覧（$defs）は、このファイルだけが持つ（ADR-0030）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["grid", "cards"],
  "properties": {
    "grid": {
      "description": "格子の段の数と列の数（R-02）",
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "cols"],
      "properties": {
        "rows": {"type": "integer", "minimum": 1},
        "cols": {"type": "integer", "minimum": 1}
      }
    },
    "cards": {
      "description": "掲載カードの一覧。カードのないマスは含めない（R-02）",
      "type": "array",
      "items": {"$ref": "#/$defs/card"}
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "printed", "price_jpy", "identification"],
      "properties": {
        "position": {
          "description": "上から1始まりの段、左から1始まりの列（R-01）",
          "type": "object",
          "additionalProperties": false,
          "required": ["row", "col"],
          "properties": {
            "row": {"type": "integer", "minimum": 1},
            "col": {"type": "integer", "minimum": 1}
          }
        },
        "printed": {
          "description": "画像から読み取った内容。知識で補わない（R-04、R-05）",
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "description": "画像に印刷されている通りのカード名"},
            "hp": {"type": "integer", "minimum": 0, "description": "読み取れなければ書かない"},
            "attacks": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "読み取れたワザ名"}
          }
        },
        "price_jpy": {
          "description": "買取価格（円の整数）。画像に価格が書かれていない、または読み取れないときは null（R-03）",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "identification": {"$ref": "#/$defs/identification"}
      }
    },
    "identification": {
      "description": "特定の結果（R-06〜R-11）",
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "card": {"$ref": "#/$defs/card_ref"},
        "candidates": {
          "description": "不明のときの候補（R-11）",
          "type": "array",
          "items": {"$ref": "#/$defs/card_ref"}
        },
        "confidence": {
          "description": "0〜1の自己申告の確信度。分析用で、採点には使わない",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "if": {"properties": {"status": {"const": "identified"}}},
      "then": {"required": ["card"]},
      "else": {"not": {"required": ["card"]}}
    },
    "card_ref": {
      "description": "カードを指すもの。M0では仮のキーの要素（ADR-0026）。M1でカードDBができたら card_id を足す",
      "type": "object",
      "additionalProperties": false,
      "required": ["pack", "number", "variant"],
      "properties": {
        "pack": {"type": "string", "minLength": 1, "description": "収録パックの商品の名前。型番ではない（R-08、ADR-0029）"},
        "number": {"type": "string", "minLength": 1, "description": "印刷されている通りのカード番号。分母やプロモの記号も含める（R-07）"},
        "variant": {"$ref": "#/$defs/variant"}
      }
    },
    "variant": {
      "description": "仕様。軸ごとに1つの値。確かめられない軸は「指定なし」（R-09、ADR-0027）",
      "type": "object",
      "additionalProperties": false,
      "required": ["edition", "finish", "stamp"],
      "properties": {
        "edition": {"$ref": "#/$defs/edition"},
        "finish": {"$ref": "#/$defs/finish"},
        "stamp": {"$ref": "#/$defs/stamp"}
      }
    },
    "status": {
      "description": "identified：特定した。unknown：不明（R-10）",
      "enum": ["identified", "unknown"]
    },
    "edition": {
      "description": "版。なし：1EDのない世代。指定なし：確かめられない",
      "enum": ["1ED", "アンリミ", "なし", "指定なし"]
    },
    "finish": {
      "description": "加工。ミラーは種類の名前で持つ。値は題材に出てきたものから足す（ADR-0027）",
      "enum": ["ノーマル", "指定なし"]
    },
    "stamp": {
      "description": "スタンプ。値は題材に出てきたものから足す（ADR-0027）",
      "enum": ["なし", "指定なし"]
    }
  }
}
